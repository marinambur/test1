{
  "name": "transaction-history",
  "version": "1.0.0",
  "description": "Fullstack application for transaction history management",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspace=backend && npm install --workspace=frontend",
    "dev": "npm run dev:frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "seed": "npm run seed --workspace=backend"
  },
  "keywords": ["nestjs", "nuxt", "graphql", "typescript", "postgresql"],
  "author": "Marina Kuznetsova",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
} 
