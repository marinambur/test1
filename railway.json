{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:backend",
    "watchPatterns": ["backend/**"]
  },
  "deploy": {
    "startCommand": "npm run start:backend",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE"
  }
} 
